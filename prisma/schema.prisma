generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TopicStatus {
  NOT_STARTED
  LEARNING
  PRACTICING
  APPLIED
}

model Roadmap {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String?
  goal        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  phases      Phase[]
}

model Phase {
  id          String   @id @default(uuid())
  roadmapId   String
  title       String
  description String?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roadmap     Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  topics      Topic[]

  @@unique([roadmapId, order])
  @@index([roadmapId])
}

model Topic {
  id          String      @id @default(uuid())
  phaseId     String
  title       String
  description String?
  status      TopicStatus @default(NOT_STARTED)
  notes       String?
  order       Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  phase       Phase       @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  evidence    Evidence[]

  @@unique([phaseId, order])
  @@index([phaseId])
  @@index([status])
}

model Evidence {
  id          String   @id @default(uuid())
  topicId     String
  title       String
  url         String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}
